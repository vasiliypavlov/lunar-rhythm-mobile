+export function resolveForecastPhaseTone({
+  phaseKey,
+  phaseStageKey = 'middle',
+  dailyFocusEdge = null,
+  backgroundEdge = null,
+  isBackgroundExactPeak = false,
+  activeLunarDay = 1
+}) {
+  const focusValence = dailyFocusEdge ? (TONE_ASPECT_VALENCE[dailyFocusEdge.aspectKey] ?? 0) : 0;
+  const bgWarning = Boolean(
