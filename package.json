{
  "name": "lunar-rhythm-mobile",
  "version": "1.1.0",
  "private": true,
  "description": "Ритм Дня — Android-приложение на базе Capacitor, портированное из Chrome-расширения lunar-rhythm-ext",
  "license": "GPL-3.0",
  "keywords": [
    "capacitor",
    "android",
    "lunar",
    "moon",
    "astro"
  ],
  "scripts": {
    "prepare:android": "node scripts/prepare-android.mjs",
    "sync": "cap sync android",
    "sync:android": "cap sync android",
    "open:android": "cap open android",
    "run:android": "cap run android",
    "build:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk:release": "cap sync android && cd android && ./gradlew assembleRelease",
    "check:js": "node scripts/check-js.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^5.1.0",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
